// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL") 
}

model Paciente {
  id Int @id @default(autoincrement())
  nome            String
  nrBI            String
  dataNascimento  DateTime
  peso            Float
  altura          Float

  consultas       Consulta[]
  prescricoes     Prescricao[]
  prontuarios     Prontuario[]
  create_at DateTime @default(now())
  update_at DateTime @updatedAt
}

model Consulta {
  idConsulta      Int          @id @default(autoincrement())
  data            DateTime

  paciente        Paciente     @relation(fields: [idPaciente], references: [id])
  idPaciente      Int

  profissional    Profissional @relation(fields: [idProfissional], references: [idProfissional])
  idProfissional  Int
}

model Profissional {
  idProfissional  Int          @id @default(autoincrement())
  nome            String
  especialidade   String
  agenda          String?

  consultas       Consulta[]
}

model Prontuario {
  idProntuario    Int         @id @default(autoincrement())
  evolucao        String
  exames          String

  paciente        Paciente    @relation(fields: [idPaciente], references: [id])
  idPaciente      Int
}

model Prescricao {
  idPrescricao    Int         @id @default(autoincrement())
  medicamento     String
  dosagem         String

  paciente        Paciente    @relation(fields: [idPaciente], references: [id])
  idPaciente      Int
}

model Estoque {
  idEstoque       Int         @id @default(autoincrement())
  nome            String
  quantidade      Int
  validade        DateTime
}

enum NivelAcesso {
  ADMIN
  USUARIO
  VISUALIZADOR
}

model Usuario {
  idUsuario      Int          @id @default(autoincrement())
  login          String        @unique
  senha          String
  nivelAcesso    NivelAcesso

  auditorias     Auditoria[]
}

model Auditoria {
  idAuditoria    Int          @id @default(autoincrement())
  operacao       String
  dataHora       DateTime

  usuario        Usuario      @relation(fields: [idUsuario], references: [idUsuario])
  idUsuario      Int
}
